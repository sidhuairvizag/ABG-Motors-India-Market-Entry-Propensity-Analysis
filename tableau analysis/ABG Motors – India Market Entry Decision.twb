      <column caption='Expected Sales' datatype='real' name='[Calculation_0097342932353024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([proba_logreg])' />
      </column>
      <column caption='Predicted Buyers' datatype='integer' name='[Calculation_0097342932807681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [pred_logreg] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Multiple of Target' datatype='real' name='[Calculation_0097342932922370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([proba_logreg]) / 12000' />
      </column>
      <column caption='Mean Probability' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0097342933037059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([proba_logreg])' />
      </column>
      <column caption='Buyers Above Threshold' datatype='integer' name='[Calculation_0097342933778437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= [Parameters].[Parameter 0097342933188612] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Target' datatype='integer' name='[Calculation_0097342945456135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(12000)' />
      </column>
      <column caption='Threshold Level' datatype='string' name='[Calculation_0097342970109960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0097342933188612] = 0.5 THEN &quot;0.50&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 0097342933188612] = 0.6 THEN &quot;0.60&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 0097342933188612] = 0.7 THEN &quot;0.70&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 0097342933188612] = 0.8 THEN &quot;0.80&quot;&#13;&#10;ELSE STR(ROUND([Parameters].[Parameter 0097342933188612],2))&#13;&#10;END' />
      </column>
      <column caption='Buyers ≥ 0.50' datatype='integer' name='[Calculation_0097342988980242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= 0.5 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Buyers ≥ 0.60' datatype='integer' name='[Calculation_0097342989312019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= 0.6 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Buyers ≥ 0.70' datatype='integer' name='[Calculation_0097342989434900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= 0.7 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Buyers ≥ 0.80' datatype='integer' name='[Calculation_0097342989582357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= 0.8 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='AGE_SEG Label' datatype='string' name='[Calculation_0177059596951553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [AGE_SEG]&#13;&#10;WHEN 1 THEN &quot;1 (&lt;200 days)&quot;&#13;&#10;WHEN 2 THEN &quot;2 (200–360 days)&quot;&#13;&#10;WHEN 3 THEN &quot;3 (360–500 days)&quot;&#13;&#10;WHEN 4 THEN &quot;4 (&gt;500 days)&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Indian Customers' datatype='integer' name='[Calculation_0177059749904395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ID])' />
      </column>
      <column caption='High Propensity Customers' datatype='integer' name='[Calculation_0177059750203404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [AGE_SEG] &gt;= 3 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Expected Sales (AGE_SEG 3 &amp; 4)' datatype='real' name='[Calculation_0177059750682638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [AGE_SEG] &gt;= 3 THEN [proba_logreg] ELSE 0 END)' />
      </column>
      <column caption='Treshold Value' datatype='real' name='[Calculation_0177059782107157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0097342933188612]' />

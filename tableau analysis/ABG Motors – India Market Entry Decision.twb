  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Dashboard 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='21'>ABG Motors – India Market Entry Decision</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='900' maxwidth='1000' minheight='900' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='90' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='93' param='vert' type-v2='layout-flow' w='98400' x='800' y='889'>
            <zone h='4667' id='94' type-v2='title' w='98400' x='800' y='889'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='93555' id='91' type-v2='layout-basic' w='98400' x='800' y='5556' />
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='34333' id='9' name='Expected Sales vs Target' w='44800' x='1400' y='20889' />
        <zone h='34222' id='10' name='Threshold Sensitivity' w='49700' x='47900' y='21000' />
        <zone forceUpdate='true' h='40000' id='15' type-v2='text' w='51500' x='47600' y='57222'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>RECOMMENDATION : PILOT, THEN ENTER</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>Note : Expected Sales = sum of purchase probabilities. Predicted Buyers = count with p ≥ 0.50.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>Sample forecast vs 12,000 target :</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>• Unadjusted expected sales: 60,318  (5.0× target)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>• Income-aligned expected sales: 40,987  (3.4× target)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>• Both remain above the 12,000 hurdle</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>Decision :</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>The sample supports entry. Do not treat 60,318 as a national forecast.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>Japan and India incomes are on different scales, so 40,987 is the cautious number . Start with a city-level pilot, then scale if conversion matches the model.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>Risks</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>1. Income scale difference (Japan vs India)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>2. Sample is one city, not a national census</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>3. Model is correlational — run CRM A/B tests before rollout</run>
          </formatted-text>
        </zone>
        <zone h='10750' id='31' name='KPIs-1' show-title='false' w='91700' x='-1500' y='9000' />
        <zone h='38667' id='89' name='Domain Shift Check' w='44600' x='1200' y='56556' />
      </zones>

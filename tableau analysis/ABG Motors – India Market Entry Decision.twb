    <worksheet name='KPIs-3'>
      <table>
        <view>
          <datasources>
            <datasource caption='Indian_Scored_Customers' name='federated.0k8jw800m43qim0zsbjo003sshy8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Probability Threshold' datatype='real' name='[Parameter 0097342933188612]' param-domain-type='range' role='measure' type='quantitative' value='0.50'>
              <calculation class='tableau' formula='0.50' />
              <range granularity='0.05' max='0.9' min='0.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0k8jw800m43qim0zsbjo003sshy8'>
            <column caption='Age Seg' datatype='integer' name='[AGE_SEG]' role='measure' type='quantitative' />
            <column caption='Buyers Above Threshold' datatype='integer' name='[Calculation_0097342933778437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [proba_logreg] &gt;= [Parameters].[Parameter 0097342933188612] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Total Indian Customers' datatype='integer' name='[Calculation_0177059749904395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([ID])' />
            </column>
            <column caption='High Propensity Customers' datatype='integer' name='[Calculation_0177059750203404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [AGE_SEG] &gt;= 3 THEN 1 ELSE 0 END)' />
            </column>

      <aliases enabled='yes' />
      <column caption='Age Car' datatype='integer' name='[AGE_CAR]' role='measure' type='quantitative' />
      <column caption='Age Seg' datatype='integer' name='[AGE_SEG]' role='measure' type='quantitative' />
